{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "[RUN] CMake (build + launch)",
			"command": "${command:cmake.launchTargetPath}",
			"problemMatcher": [],
			"dependsOn": [
				"[BUILD] CMake"
			],
			"dependsOrder": "sequence"
		},
		{
			"type": "process",
			"label": "[LAUNCH] CMake",
			"command": "${command:cmake.launchTargetPath}",
			"problemMatcher": [],
		},
		{
			"type": "cmake",
			"label": "[BUILD] CMake",
			"command": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		}
	]
}
